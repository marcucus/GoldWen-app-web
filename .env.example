# GoldWen Web — Environment Configuration
# Copy this file to .env.local and fill in the values

# App Store / Google Play links
# Leave empty to show "coming soon" disabled buttons
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Site URL (used for canonical tags and sitemap)
NEXT_PUBLIC_SITE_URL=https://goldwen.app

# Optional analytics: disabled by default, still requires visitor consent when true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Publisher: physical person (no company currently)
LEGAL_PUBLISHER_NAME=Adrien Marques
LEGAL_PUBLISHER_ADDRESS=
LEGAL_CONTACT_EMAIL=marquesadrien.site@gmail.com
LEGAL_CONTACT_PHONE=

# Shared rate limiter (Upstash-compatible Redis REST). Required in production.
CONTACT_REDIS_REST_URL=
CONTACT_REDIS_REST_TOKEN=

# Contact form — SMTP (requires: npm install nodemailer @types/nodemailer)
CONTACT_EMAIL_TO=goldwen.supp.app@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM=goldwen.supp.app@gmail.com
